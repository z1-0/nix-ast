+-- | Render the receiver of an attribute select. A receiver that is a
+--   function application must be parenthesized: @f x.y@ re-parses as
+--   @f (x.y)@, not @(f x).y@. The generic precedence/associativity rules
+--   do not catch this because application and select share both
+--   precedence and associativity.
+selectReceiver :: NixDoc ann -> Doc ann
+selectReceiver sub =
+  if rootOp sub == appOpDef
+    then parens (getDoc sub)
+    else wrap appOpDef sub
+
